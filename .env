PORT=3000
AIDER_MODEL=glm-4.5-air
AIDER_API_BASE=https://open.bigmodel.cn/api/paas/v4
ZAI_API_KEY=12139402cf79409582813f5ada668907.5nmPAhhtXT5NMiO7
JWT_SECRET=xxx
JWT_ALGORITHM=HS256

# S3 第 23-24 天：多厂商适配器 API Key
# 各厂商 Key 可选配置；未配置的厂商对应模型仍会在 /v1/models 返回，
# 但实际调用时会返回 503 服务不可用
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 会话管理配置（第 11-12 天：后端会话管理 & 历史记忆）
SESSION_TTL_SECONDS=3600
SESSION_TOKEN_BUDGET=8000
SESSION_TOKEN_MARGIN=0.2
SESSION_MAX_ROUNDS=5
# 主动清理过期会话的后台任务执行间隔（第 19-20 天：会话过期机制）
SESSION_CLEANUP_INTERVAL_SECONDS=300

# Redis 配置（S3 第 21-22 天：限频与配额系统）
# 未配置 Redis 时自动降级为内存实现
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# 限频配置（S3 第 21-22 天）
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=500

# 配额配置（S3 第 21-22 天）
QUOTA_LIMIT_PER_DAY=100000

# S3 第 28-29 天：请求超时与 max_tokens 配置
# 普通对话（chat 模式）使用较短超时，单文件生成（new 模式）使用更长超时，
# 因为完整文件生成往往比对话需要更多推理时间。
CHAT_TIMEOUT_SECONDS=60.0
NEW_FILE_TIMEOUT_SECONDS=120.0
CHAT_MAX_TOKENS=4096
NEW_FILE_MAX_TOKENS=8192

# S4 第 33-34 天：代码向量化配置
# EMBEDDING_MODE:
#   local  - 仅使用本地模型（all-MiniLM-L6-v2，384维，~80MB，免费，无需API Key）
#   remote - 仅使用远程 Embedding API
#   auto   - 优先本地，加载失败自动降级远程（默认）
EMBEDDING_MODE=local
EMBEDDING_LOCAL_MODEL=all-MiniLM-L6-v2
EMBEDDING_LOCAL_LOAD_TIMEOUT=120.0
HF_HUB_OFFLINE=1

# 远程 Embedding 配置（仅 mode=remote 或 auto 降级时使用）
# 默认 OpenAI：
#    EMBEDDING_REMOTE_API_BASE=https://api.openai.com/v1
#    EMBEDDING_REMOTE_MODEL=text-embedding-3-small
#若使用智谱 AI（已有 ZAI_API_KEY），改为以下值：
EMBEDDING_REMOTE_API_BASE=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_REMOTE_MODEL=embedding-3

EMBEDDING_REMOTE_BATCH_SIZE=64
EMBEDDING_CACHE_DB=.ai_index/embeddings_cache.sqlite
# 向量模型版本由后端自动检测（如 all-MiniLM-L6-v2-384 / text-embedding-3-small-1536），
# 写入每个 Chunk 的 embedding_version 字段，用于维度迁移。
# Embedding API Key（任选其一，优先级 EMBEDDING_API_KEY > OPENAI_API_KEY > ZAI_API_KEY）
# 使用本地模型时无需配置；使用远程 API 时必须配置
EMBEDDING_API_KEY=

# S4 第 35-36 天：向量数据库（LanceDB）配置
VECTOR_STORE_DB_PATH=.ai_index/lancedb
VECTOR_STORE_TABLE_NAME=code_chunks
VECTOR_SEARCH_TOP_K=10
